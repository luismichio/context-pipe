# Context-Pipe Configuration Example

# The root directory of your workspace (used for path protection)
# SIFT_WORKSPACE_ROOT=C:\Users\yourname\projects\my-app

# Set to 'true' to bypass path protection (not recommended for production)
# SIFT_ALLOW_GLOBAL_READS=false

# Log level for the pipe hooks (DEBUG, INFO, WARNING, ERROR)
SIFT_LOG_LEVEL=INFO
SIFT_LOG_FILE=pipe_debug.log

# Model ready timeout in milliseconds
SIFT_MODEL_READY_WAIT_MS=1500
