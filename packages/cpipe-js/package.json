{
  "name": "@context-pipe/client",
  "version": "0.5.11",
  "description": "Client-side TypeScript port of the Context-Pipe (cpipe) pipeline engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "context-pipe",
    "cpipe",
    "pwa",
    "llm",
    "context",
    "sift"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  }
}
