{
  "version": "1.0",
  "description": "Standard high-fidelity context pipes for the Studio of Two.",
  "pipes": [
    {
      "name": "standard-distill",
      "description": "Default log sifting pipe.",
      "nodes": [
        {
          "cmd": "sift-core",
          "args": ["logs"],
          "help_msg": "sift-core not found. Please install the Rust refinery via 'cargo install semantic-sift-core'."
        }
      ]
    },
    {
      "name": "secure-distill",
      "description": "Masks secrets before sifting logs.",
      "nodes": [
        {
          "cmd": "context-pipe-mask",
          "args": []
        },
        {
          "cmd": "sift-core",
          "args": ["logs"],
          "help_msg": "sift-core not found. Please install the Rust refinery via 'cargo install semantic-sift-core'."
        }
      ]
    },
    {
      "name": "semantic-refinery",
      "description": "High-intelligence neural distillation.",
      "nodes": [
        {
          "cmd": "sift-core",
          "args": ["semantic", "--rate", "0.5"],
          "help_msg": "sift-core not found. Please install the Rust refinery via 'cargo install semantic-sift-core'."
        }
      ]
    },
    {
      "name": "test-pipe",
      "description": "Verification pipe using findstr.",
      "nodes": [
        {
          "cmd": "findstr",
          "args": ["SIGNAL"]
        }
      ]
    },
    {
      "name": "full-refinery",
      "description": "Complete ingestion and distillation chain.",
      "nodes": [
        {
          "cmd": "context-pipe-ingest",
          "args": [],
          "help_msg": "Multi-modal ingestion failed. Please run 'pip install context-pipe[multi-modal]'."
        },
        {
          "cmd": "sift-core",
          "args": ["semantic", "--rate", "0.3"],
          "help_msg": "sift-core not found. Please install the Rust refinery via 'cargo install semantic-sift-core'."
        }
      ]
    }
  ],
  "mappings": [
    {
      "trigger": "tool:search|grep|find",
      "pipe": "semantic-refinery"
    },
    {
      "trigger": "size:>10000",
      "pipe": "semantic-refinery"
    },
    {
      "trigger": "default",
      "pipe": "standard-distill"
    }
  ]
}
