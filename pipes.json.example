{
  "version": "1.0",
  "description": "High-fidelity context pipe template for the Studio of Two.",
  "_note": "All 'cmd' values should be bare command names (e.g. 'semantic-sift-cli'). The orchestrator resolves full paths at runtime via PATH lookup. Do NOT commit hardcoded absolute paths.",
  "pipes": [
    {
      "name": "standard-distill",
      "description": "Fast log sifting via Semantic-Sift.",
      "nodes": [
        {
          "cmd": "semantic-sift-cli",
          "args": ["logs"],
          "help_msg": "semantic-sift-cli not found. Run 'uv tool install semantic-sift'."
        }
      ]
    },
    {
      "name": "semantic-refinery",
      "description": "Neural distillation for code and prose (Hybrid Engine).",
      "nodes": [
        {
          "cmd": "semantic-sift-cli",
          "args": ["semantic", "--rate", "0.5"],
          "help_msg": "semantic-sift-cli not found. Run 'uv tool install semantic-sift'."
        }
      ]
    },
    {
      "name": "secure-distill",
      "description": "PII Masking -> Log Distillation.",
      "nodes": [
        {
          "type": "script",
          "cmd": "pii-masker"
        },
        {
          "cmd": "semantic-sift-cli",
          "args": ["logs"]
        }
      ]
    },
    {
      "name": "error-focus-chain",
      "description": "Extracts only error lines via grep, then compresses them.",
      "_note": "Use bare 'grep' — PATH resolution handles the full path at runtime.",
      "nodes": [
        {
          "cmd": "grep",
          "args": ["-i", "error"],
          "help_msg": "grep not found. On Windows, use 'findstr' with args [\"error\"]."
        },
        {
          "cmd": "semantic-sift-cli",
          "args": ["semantic", "--rate", "0.6"],
          "help_msg": "semantic-sift-cli not found. Run 'uv tool install semantic-sift'."
        }
      ]
    },
    {
      "name": "architectural-review",
      "description": "Applies security and architecture lenses, then sifts.",
      "nodes": [
        {
          "type": "script",
          "cmd": "security-auditor"
        },
        {
          "type": "script",
          "cmd": "performance-auditor"
        },
        {
          "cmd": "semantic-sift-cli",
          "args": ["auto", "--rate", "0.4"],
          "help_msg": "semantic-sift-cli not found. Run 'uv tool install semantic-sift'."
        }
      ]
    },
    {
      "name": "advanced-ingestion-chain",
      "description": "Bring your own parser: Custom LlamaIndex/MarkItDown parser piped directly into the native Rust sidecar.",
      "nodes": [
        {
          "cmd": "python",
          "args": ["-m", "my_custom_parser"]
        },
        {
          "cmd": "sift-core",
          "args": ["semantic", "--rate", "0.4"],
          "help_msg": "sift-core not found. Run 'uv tool install semantic-sift' (includes sift-core binary)."
        }
      ]
    },
    {
      "name": "react-expert-chain",
      "description": "Pre-processes code through an expert instruction lens before sifting.",
      "nodes": [
        {
          "type": "script",
          "cmd": "react-code-fix-linter"
        },
        {
          "cmd": "semantic-sift-cli",
          "args": ["semantic", "--rate", "0.6"],
          "help_msg": "semantic-sift-cli not found. Run 'uv tool install semantic-sift'."
        }
      ]
    }
  ],
  "mappings": [
    {
      "trigger": "tool:web_search|web_fetch|google_web_search",
      "pipe": "semantic-refinery"
    },
    {
      "trigger": "tool:search_code|grep_search|glob|find_symbol",
      "pipe": "semantic-refinery"
    },
    {
      "trigger": "size:>10000",
      "pipe": "semantic-refinery"
    },
    {
      "trigger": "default",
      "pipe": "standard-distill"
    }
  ],
  "servers": {
    "firecrawl": {
      "command": [
        "python",
        "-m",
        "firecrawl_mcp.server"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "context-mode": {
      "command": [
        "python",
        "-m",
        "context_mode.server"
      ]
    }
  }
}
